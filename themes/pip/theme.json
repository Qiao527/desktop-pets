{
  "schemaVersion": 1,
  "name": "Pip",
  "author": "Qiao527",
  "version": "1.0.0",
  "description": "Original pixel sprout. Default theme; artwork generated by tools/pip-theme/build.js (MIT).",
  "license": "MIT",

  "viewBox": { "x": -15, "y": -25, "width": 45, "height": 45 },

  "layout": {
    "contentBox": { "x": -3, "y": -3, "width": 22, "height": 20 },
    "centerX": 8,
    "baselineY": 16,
    "visibleHeightRatio": 0.58,
    "baselineBottomRatio": 0.05
  },

  "eyeTracking": {
    "enabled": true,
    "states": ["idle"],
    "eyeRatioX": 0.511,
    "eyeRatioY": 0.756,
    "maxOffset": 2,
    "bodyScale": 0.33,
    "shadowStretch": 0.15,
    "shadowShift": 0.3,
    "ids": { "eyes": "eyes-js", "body": "body-js", "shadow": "shadow-js" },
    "shadowOrigin": "8px 15px"
  },

  "states": {
    "idle":         ["pip-idle-follow.svg"],
    "typing":       ["pip-working.svg"],
    "listening":    ["pip-listening.svg"],
    "yawning":      ["pip-yawning.svg"],
    "dozing":       ["pip-dozing.svg"],
    "collapsing":   ["pip-sleeping.svg"],
    "thinking":     ["pip-thinking.svg"],
    "working":      ["pip-working.svg"],
    "juggling":     ["pip-working.svg"],
    "sweeping":     ["pip-working.svg"],
    "error":        ["pip-error.svg"],
    "attention":    ["pip-happy.svg"],
    "notification": ["pip-notification.svg"],
    "carrying":     ["pip-working.svg"],
    "sleeping":     ["pip-sleeping.svg"],
    "waking":       ["pip-waking.svg"]
  },

  "workingTiers": [
    { "minSessions": 1, "file": "pip-working.svg" }
  ],

  "jugglingTiers": [
    { "minSessions": 1, "file": "pip-working.svg" }
  ],

  "idleAnimations": [
    { "file": "pip-idle-look.svg", "duration": 6500 }
  ],

  "displayHintMap": {
    "clawd-working-building.svg": "pip-working.svg",
    "clawd-working-typing.svg": "pip-working.svg",
    "clawd-working-juggling.svg": "pip-working.svg",
    "clawd-working-conducting.svg": "pip-working.svg",
    "clawd-idle-reading.svg": "pip-thinking.svg",
    "clawd-working-debugger.svg": "pip-thinking.svg",
    "clawd-working-thinking.svg": "pip-thinking.svg"
  },

  "timings": {
    "yawnDuration": 3000,
    "wakeDuration": 1500,
    "collapseDuration": 800,
    "mouseIdleTimeout": 45000,
    "mouseSleepTimeout": 120000
  },

  "hitBoxes": {
    "default":  { "x": 2, "y": 2, "w": 12, "h": 14 },
    "sleeping": { "x": 1, "y": 7, "w": 14, "h": 9 },
    "wide":     { "x": 0, "y": -4, "w": 19, "h": 20 }
  },
  "wideHitboxFiles": ["pip-notification.svg"],
  "sleepingHitboxFiles": ["pip-sleeping.svg"],

  "reactions": {
    "drag":       { "file": "pip-react-drag.svg" },
    "clickLeft":  { "file": "pip-react-squish.svg", "duration": 1500 },
    "clickRight": { "file": "pip-react-squish.svg", "duration": 1500 },
    "annoyed":    { "file": "pip-react-annoyed.svg", "duration": 2500 },
    "double":     { "files": ["pip-react-squish.svg"], "duration": 1500 }
  },

  "miniMode": { "supported": false },

  "sounds": { "complete": "pip-complete.wav", "confirm": "pip-confirm.wav" }
}
