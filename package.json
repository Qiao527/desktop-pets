{
  "name": "desktop-pets",
  "version": "0.6.0",
  "description": "macOS desktop pet with non-blocking activity detection, opt-in private time tracking, and AI-agent awareness.",
  "main": "src/main.js",
  "scripts": {
    "start": "node launch.js",
    "build": "npm run build:mac:unsigned",
    "build:mac": "electron-builder --mac",
    "build:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "check:package": "node scripts/check-package.js \"dist/mac-arm64/Desktop Pets.app/Contents/Resources/app.asar\"",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/activity/** --test-coverage-include=src/insights/controller.js --test-coverage-include=src/local-request-guard.js --test-coverage-lines=95 --test-coverage-branches=85 test/*.test.js",
    "install:gemini-hooks": "node hooks/gemini-install.js",
    "install:cursor-hooks": "node hooks/cursor-install.js",
    "install:kiro-hooks": "node hooks/kiro-install.js"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "macos",
    "activity-tracking",
    "privacy",
    "menubar"
  ],
  "author": "Qiao527",
  "license": "MIT",
  "homepage": "https://github.com/Qiao527/desktop-pets#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qiao527/desktop-pets.git"
  },
  "bugs": {
    "url": "https://github.com/Qiao527/desktop-pets/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "build": {
    "appId": "com.desktoppets.app",
    "productName": "Desktop Pets",
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Desktop-Pets-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "maintainer": "Qiao527 <Qiao527@users.noreply.github.com>",
      "icon": "assets/icons",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "files": [
      "src/**/*",
      "assets/sounds/pip-*.wav",
      "assets/tray-icon*.png",
      "assets/tray-menubar.png",
      "assets/tray-menubarTemplate.png",
      "assets/tray-menubarTemplate@2x.png",
      "hooks/**/*",
      "extensions/**/*",
      "agents/**/*",
      "themes/pip/**/*",
      "LICENSE",
      "NOTICE.md"
    ],
    "asarUnpack": [
      "hooks/**/*",
      "extensions/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Qiao527",
        "repo": "desktop-pets"
      }
    ]
  },
  "devDependencies": {
    "electron": "^42.11.18",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "htmlparser2": "^12.0.0",
    "koffi": "^2.15.2"
  }
}
